# Voie Express Environment Variables
# NEVER commit actual keys to this file. Use the Settings menu in AI Studio.

# -----------------------------------------------------------------------------
# INFRAESTRUTURA DE IA
# -----------------------------------------------------------------------------
# O Voie Express utiliza exclusivamente o Google Gemini para análise técnica.
# A chave GEMINI_API_KEY é injetada automaticamente pelo AI Studio.
GEMINI_API_KEY=

# Google Maps Platform API Key (Routes API enabled)
GOOGLE_MAPS_API_KEY=

# OpenRouteService API Key
NEXT_PUBLIC_ORS_KEY=


# Mapbox Access Token (Substituto de Alta Precisão ao Google Maps, 100k requisições grátis/mês)
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenWeatherMap API Key
NEXT_PUBLIC_OPENWEATHER_KEY=

# TomTom Traffic API Key (Optional)
NEXT_PUBLIC_TOMTOM_KEY=

# Visual Crossing Weather API (Optional Fallback)
NEXT_PUBLIC_VISUALCROSSING_KEY=
