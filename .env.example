# HARPIA Environment Variables
# NEVER commit actual keys to this file. Use the Settings menu in AI Studio.

# -----------------------------------------------------------------------------
# INFRAESTRUTURA DE IA
# -----------------------------------------------------------------------------
# O HARPIA pode utilizar o Google Gemini, OpenAI ou AnyAPI para análise técnica.
# Chaves API são configuradas no Settings do AI Studio.
ANYAPI_API_KEY=
ANYAPI_BASE_URL=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google Maps Platform API Key (Routes API enabled)
GOOGLE_MAPS_API_KEY=

# AwesomeAPI CEP & Busca de Endereços (Motor Principal de Endereços)
# Documentação: https://cep.awesomeapi.com.br
AWESOMEAPI_KEY=

# OpenRouteService API Key
NEXT_PUBLIC_ORS_KEY=


# Mapbox Access Token (Substituto de Alta Precisão ao Google Maps, 100k requisições grátis/mês)
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenWeatherMap API Key
NEXT_PUBLIC_OPENWEATHER_KEY=

# TomTom Traffic API Key (Optional)
NEXT_PUBLIC_TOMTOM_KEY=

# Visual Crossing Weather API (Optional Fallback)
NEXT_PUBLIC_VISUALCROSSING_KEY=


